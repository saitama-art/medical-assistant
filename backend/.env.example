# 医疗健康智能助手——环境变量样例（登录与用户隔离，2026-10-23）
# 复制为 .env 并按需修改。真实 .env 已 gitignore，切勿提交。

# ---- 现有：模型密钥（必填）----
DEEPSEEK_API_KEY=sk-xxxxxxxx

# ---- 应用数据库（默认 backend/data/app.db，一般不用改）----
# APP_DB_PATH=

# ---- CORS 白名单（凭证模式下禁止 *；逗号分隔）----
# 开发默认 http://localhost:3000,http://127.0.0.1:3000
# CORS_ORIGINS=http://localhost:3000

# ---- 登录 Cookie（开发跨端口默认 SameSite=None + Secure；
#      生产同源部署建议 SameSite=Lax）----
# SESSION_COOKIE_SAMESITE=none
# SESSION_COOKIE_SECURE=true

# ---- 会话运行时持久化（可选；开启后按 {user_id}/{sid}.json 落盘）----
# SESSION_PERSIST_DIR=

# ---- 验收账号（acceptance/runner.py 自举登录用）----
# ACCEPTANCE_USER=acceptance
# ACCEPTANCE_PASSWORD=acceptance-pass-123
